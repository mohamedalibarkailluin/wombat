{% extends "layouts/_layout" %}
{% block headScripts %}<script src="/vendor/easepick.umd.min.js"></script>{% endblock %}
{% block scripts %}<script type="module" src="/public/js/pages/impact-error.js"></script>{% endblock %}
{% block content %}

<form class="filter-bar" method="get" action="" id="filterForm" v-scope="DateFilter()" @vue:mounted="mount($el)" @submit.prevent="submit()">
  {% include "components/_date-range" with {"timeRange": timeRange, "maxSpan": maxSpan} %}
  <button type="submit" class="btn-apply">Apply</button>
</form>

<!-- Main -->
<div class="main">
  <div class="error-card">
    <div class="error-header">
      <div class="error-dot"></div>
      <span class="error-label">No data</span>
    </div>
    <div class="error-title">No CPU usage found</div>
    <div class="error-body">
      No CPU metrics were recorded for the selected time range.
      Try a wider range or check that the monitoring agent is running.
    </div>
  </div>
</div>



{% endblock %}

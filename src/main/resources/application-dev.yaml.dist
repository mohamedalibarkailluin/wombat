quarkus:
  datasource:
    jdbc:
      url: "jdbc:sqlite:data/db/local.db"
    # To run against the compose `postgres` service instead, replace the two lines above with:
    #   db-kind: postgresql
    #   username: wombat
    #   password: wombat
    #   jdbc:
    #     url: "jdbc:postgresql://localhost:5432/wombat"
    # db-kind also selects the Flyway chain (classpath:db/migration/${quarkus.datasource.db-kind})
    # and is fixed at build time, so dev mode has to be restarted after switching.

# Connector endpoints, read through BoaviztaProperties / EcologitsProperties. Both are required with no default.
connector:
  boavizta:
    uri: "http://localhost:5001/v1/"
  ecologits:
    uri: "http://localhost:5002/"

# Secret resolution directory / keystore (optional)
#wombat:
#  secret:
#    directory:
#      path: /secrets

metrics:
  aggregation-window:
    duration: 5
    unit: MINUTES

ui:
  max-date-range:
    duration: 1
    unit: YEARS

monitor:
  heartbeat: "*/10 * * * * ?"
  environments-file: monitored/monitored-environments-dev.yaml

# Access control. `quarkus.oidc.tenant-enabled` is the only switch: false (the default set in
# application.yaml) contacts no provider and leaves every request anonymous. Uncomment the block below to
# require a Google Workspace account — the provider, the `hd: illuin.tech` claim requirement and the
# public/authenticated permission sets are already configured in application.yaml, so only the OAuth client
# credentials are environment-specific. Create them in the Google Cloud console (APIs & Services >
# Credentials > OAuth client ID > Web application) and register http://localhost:8080/auth/callback there.
# Startup fails fast if the credentials are missing.
#quarkus:
#  oidc:
#    tenant-enabled: true
#    client-id: <client-id>.apps.googleusercontent.com
#    credentials:
#      secret: <client-secret>
#    authentication:
#      # Mandatory with Google: without it Quarkus uses the current request URI as redirect_uri, which can
#      # never match the fixed URIs registered in the console. Register this exact path there, per origin.
#      redirect-path: /auth/callback
#      # Send the caller back to the page they asked for; without it they always land on redirect-path.
#      restore-path-after-redirect: true
#      extra-params:
#        # Pre-selects the Workspace domain in Google's account chooser. A hint only — Google lets the caller
#        # tamper with it, which is why the `hd` claim is required at token validation.
#        hd: illuin.tech
#  # The Dev UI sits behind the login too; uncomment to keep it reachable while authentication is on.
#  #http:
#  #  auth:
#  #    permission:
#  #      dev-ui:
#  #        policy: permit
#  #        paths:
#  #          - /q/dev/*
# Note: do NOT set quarkus.oidc.logout.path — Google publishes no end_session_endpoint, so RP-initiated
# logout cannot work. The header's sign-out link hits /logout (SessionController), which clears the local
# session cookie; the Google account itself stays signed in on the device.

# Which SDK modules get wired into the app. Each defaults to true, so this block is only needed to switch one off
# (e.g. no reachable cluster or Prometheus in a local setup). A disabled module is simply absent from the registry,
# so assets of its type are skipped rather than failing.
module:
  kubernetes-api:
    enabled: true
  llm-prometheus:
    enabled: true
  llm-static:
    enabled: true

backup:
  enabled: true
  cron: "0 0 * * * ?"  # hourly
  cleanup:
    enabled: true
    cron: "0 0 3 * * ?"
    retain-last: 10
  s3:
    key-prefix: sqlite/
    endpoint: http://localhost:8333
    bucket: wombat-bucket
    access-key: admin
    secret-key: secret

llm-simulator:
  enabled: false
  cron: "*/10 * * * * ?"
  metric-name: generation.tokens
  models:
    - name: mistral-large-latest
      min-tokens: 100
      max-tokens: 2000
